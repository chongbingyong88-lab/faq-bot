DATABASE_URL=postgresql://faqbot:faqbot@localhost:5433/faqbot

# which provider answers questions: anthropic | gemini | deepseek
# gemini | anthropic | groq | openrouter | cerebras | together | deepseek | openai
# The last six speak the same OpenAI-compatible API, so swapping when a free
# daily quota runs out is this one line plus a key.
LLM_PROVIDER=gemini

# only the one matching LLM_PROVIDER is needed
GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
# Free tiers worth having as a fallback when Gemini's daily cap is hit:
#   GROQ_API_KEY=gsk_...          console.groq.com  — largest free allowance
#   CEREBRAS_API_KEY=csk-...      cloud.cerebras.ai
#   OPENROUTER_API_KEY=sk-or-...  openrouter.ai     — models ending :free

# optional model overrides
# GEMINI_MODEL=gemini-2.0-flash-lite
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# DEEPSEEK_MODEL=deepseek-chat
# GROQ_MODEL=llama-3.3-70b-versatile
# Model ids churn. To see what a key can actually reach:
#   python -c "from ingest.llm import list_models; print(list_models('groq'))"
# Per-minute pacing, if a provider throttles: GROQ_RPM=30, OPENROUTER_RPM=20
# GEMINI_RPM=15
# EMBED_MODEL=gemini-embedding-001
# EMBED_DIM=1536          # must stay under pgvector HNSW's 2000-dim limit

# --- WhatsApp Cloud API (Stage 5) ---
WHATSAPP_VERIFY_TOKEN=any-random-string-you-choose
WHATSAPP_APP_SECRET=from Meta app > Settings > Basic > App Secret
WHATSAPP_TOKEN=temporary-access-token-from-WhatsApp-API-Setup
WHATSAPP_PHONE_NUMBER_ID=from the same WhatsApp API Setup page
WHATSAPP_SITE=sepadental
WHATSAPP_BUSINESS=SEPA Dental
# WHATSAPP_DEBOUNCE_S=2.0
# where escalations are sent (must be on the WhatsApp allowed list)
ESCALATION_NUMBER=60xxxxxxxxx
# HISTORY_TURNS=6
# HISTORY_WINDOW_MIN=30

# free static ngrok domain so the webhook URL never changes
NGROK_DOMAIN=your-name.ngrok-free.app

# Dashboard sign-in. The webhook has to be publicly reachable for Meta, so the
# whole app is on a public URL — anything showing a customer's phone number or
# question needs a password. Unset means the dashboard stays SHUT, not open.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Per-clinic sign-in (multi-tenant): in tenants.json give each entry a
# "password_env", and that clinic signs in with its site name as the username
# and sees only its own customers.

# Grade with a different provider and family than the bot, so a model change
# is not scored on a yardstick that moved with it.
JUDGE_MODEL=groq:qwen/qwen3.8-27b

# --- Resilience: what happens when a provider dies mid-conversation ---
# A comma-separated chain tried in order after LLM_PROVIDER fails. This is
# the difference between "the bot is down today" and "the bot got slower for
# a minute", so it is worth setting even on a hobby deployment. Free daily
# caps are per-model, so list a different provider AND a different family.
# LLM_FALLBACK=groq:qwen/qwen3.8-27b,gemini:gemini-3.5-flash-lite

# Deadline for the whole answer including fallbacks, and for one attempt.
# Gemini enforces the per-attempt value server-side and returns 504
# DEADLINE_EXCEEDED rather than dropping the socket; its floor is 10s, so
# anything lower is silently ignored. Keep DEADLINE comfortably above
# ATTEMPT_TIMEOUT or the chain runs out of budget before it can fall back —
# that bug cost a whole eval run.
# LLM_DEADLINE_S=30
# LLM_ATTEMPT_TIMEOUT_S=15
# LLM_MAX_RETRIES=6
# LLM_ATTEMPTS_BEFORE_FALLBACK=2

# A model that returned RESOURCE_EXHAUSTED is skipped until its quota day
# rolls over (Pacific for Gemini, UTC elsewhere) — retries are billed against
# the cap that is already spent. This flat value is only a fallback for when
# the reset time cannot be computed.
# LLM_EXHAUSTED_COOLDOWN_S=900
# LLM_COOLDOWN_FILE=data/llm_cooldown.json

# --- Retrieval and generation knobs ---
# KEEP: chunks passed to the model. MIN_SCORE: cosine floor on a 0..1 scale
# (not a reranker logit — the reranker is gone). 0.0 keeps everything, which
# is the deliberate starting point and still wants calibrating against the
# eval: too high invents refusals, too low invents answers.
# KEEP=5
# MIN_SCORE=0.0
# LLM_MAX_TOKENS=600
# EMBED_BATCH=64

# --- Voice notes ---
# TRANSCRIBE_PROVIDER=groq
# TRANSCRIBE_MODEL=whisper-large-v3

# --- Escalation timing and business hours ---
# Days are 0=Monday. Outside these hours an escalation says so instead of
# promising a reply that nobody is there to send.
# BUSINESS_HOURS=09:00-18:00
# BUSINESS_DAYS=0,1,2,3,4,5
# CLINIC_UTC_OFFSET=8
# HANDOVER_MINUTES=15        # human has this long before the bot resumes
# NUDGE_AFTER_MINUTES=30     # remind staff about an unanswered escalation
# SESSION_HOURS=24           # matches Meta's 24-hour service window
# CONTEXT_MINUTES=30
# SWEEP_SECONDS=120          # background sweep interval

# --- Data retention (days) ---
# Customer questions are personal data. Keep the window short enough to
# defend and long enough to debug; question text expires before the
# conversation record it belongs to.
# RETAIN_QUESTION_TEXT_DAYS=90
# RETAIN_CONVERSATIONS_DAYS=90
# RETAIN_ESCALATIONS_DAYS=90
# RETAIN_HISTORY_DAYS=90
# RETAIN_SEEN_DAYS=7
# LOG_MESSAGE_TEXT=   # set to 1 to log message bodies; off by default on purpose
